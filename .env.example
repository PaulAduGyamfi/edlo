ENVIRONMENT=development
DATABASE_URL=sqlite:///./edlo.db
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=524288000

# --- queue ---
# rq: Redis for development (docker compose up -d redis), then run a worker
# on the host with `python -m apps.worker.main`. sqs: production.
QUEUE_BACKEND=rq
REDIS_URL=redis://localhost:6379/0
#SQS_QUEUE_URL=

# --- storage ---
# local: files under UPLOAD_DIR, served via /dev/storage. s3: run
# `docker compose up -d minio minio-init` and set the block below.
STORAGE_BACKEND=local
#STORAGE_BACKEND=s3
#S3_BUCKET=edlo-media
#S3_REGION=us-east-1
#S3_ENDPOINT_URL=http://localhost:9000
#AWS_ACCESS_KEY_ID=minioadmin
#AWS_SECRET_ACCESS_KEY=minioadmin

# --- AI ---
AI_ENABLED=false
MODEL_NAME=
MODEL_BASE_URL=
MODEL_API_KEY=
API_KEYS={"albert": "replace-with-long-random-value", "chris": "replace-with-long-random-value", "paul": "replace-with-long-random-value"}
